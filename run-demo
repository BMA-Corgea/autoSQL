# The other nine have never been watched failing.
#
# One line to overturn: *"implement §8.2 properly"* — then this whole
# section, both printed disclosures and the exit-2 refusal go, and the flag
# does what the plan says.
MUTATION_PASS_STATE="not implemented — plan §8.2 has never run"

mutation_pass_disclosure() {
  echo "run-demo test: DISCLOSURE — plan §8.2's mutation pass HAS NOT RUN. './run-demo test --mutants' is $MUTATION_PASS_STATE, here or anywhere under demo/."
  echo "run-demo test:   M1, M4, M8, M16 were hand-run once and killed. M6, M12, M13 have standing detector tests in this suite."
  echo "run-demo test:   The other nine of the sixteen have never been watched failing. The counts below are the ordinary suite and are not evidence for §8.2."
}

run_suite() {
  if [[ "${1:-}" == "--mutants" ]]; then
    echo "run-demo test: --mutants is plan §8.2's mutation pass and it is NOT IMPLEMENTED — not in this verb, not anywhere under demo/. It has never run." >&2
    echo "run-demo test: sixteen mutants are named in plan §8.2. Four (M1, M4, M8, M16) were hand-run once and killed; three (M6, M12, M13) have standing detector tests in this suite; the other nine have never been watched failing." >&2
    echo "run-demo test: refusing rather than running the ordinary suite and letting it look like a mutation run. './run-demo test' prints this same disclosure above its summary line, every run." >&2
    exit 2
  fi

  # Before anything is brought up or connected to: this file has no
  # connection factory of its own (B13, and the HIGH finding above).
  if ! assert_the_launcher_has_no_driver_of_its_own; then
    exit 1
  fi
  echo "run-demo test: the launcher opens no connection of its own — demo/server/db.py is the one factory (B13, checked here, and the check was watched catching a planted import)"

