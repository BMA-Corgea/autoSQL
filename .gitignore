# ── AutoDev: per-machine, must NOT travel ────────────────────────────────
# A bare {"ok":true} with no machine identity. If this rides along, a fresh
# clone's doctor reports "full access PROVEN" for a probe it never ran.
# Re-earn it on each machine: bash <plugin>/ops/verify-access.sh .
.autodev/access-verified.json
.autodev/logs/

# Generated view — rebuilt on demand by /autodev:board
.autodev/board.html

# ── autoSQL project ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

node_modules/
dist/
build/
*.tsbuildinfo

# T-2 (B19): the demo's committed front-end bundles live at demo/static/js/
# and its committed wheelhouse at demo/vendor/wheels/ — NEITHER is named
# dist/ or build/, on purpose. AC-36 requires those bundles to run from a
# fresh clone with no Node present, so if a pattern above ever starts
# matching demo/static/js/ or demo/vendor/wheels/, the bundle/wheels would
# be silently untracked: present on the build machine, missing on a clone.
# Do not add a "js/", "wheels/", or "static/" pattern to this file.
# Verified clean today: `git check-ignore -v demo/static/js/app.js` and
# `git check-ignore -v demo/vendor/wheels/*.whl` both report no match.

# Secrets and local config — never commit
.env
.env.*
!.env.example
*.pem

# Local scratch
.DS_Store
Thumbs.db
*.log

# Notification delivery state — per-machine, not shared work.
# .autodev/outbox/  = undelivered packets (ops/notify-telegram.sh's retry queue)
# .autodev/notify/  = AutoDev's exactly-once sent.jsonl + in-flight claim files
# TRADEOFF (Evan, two machines): keeping these untracked means a gate hold that is
# live when you switch machines can page you a second time from the other one.
# Track them instead if that ever annoys you — delete these two lines.
.autodev/outbox/
.autodev/notify/

# Generated repo map (.repo-tour) — regenerable output, never committed.
# It was swept into the T-8 branch once by a broad `git add -A`; this stops that.
.repo-tour/
